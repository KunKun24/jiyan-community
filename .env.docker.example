# 复制为 .env 后再改：cp .env.docker.example .env
APP_PORT=8080

# 数据库（与 docker-compose.yml 里的默认值保持一致）
DB_NAME=shequ
DB_USER=shequ
DB_PASSWORD=shequ-change-me
DB_ROOT_PASS=root-change-me

# 会话签名密钥：随便一串足够长的随机字符
SESSION_SECRET=change-me-to-a-long-random-string

# 站点
SITE_NAME=极验社区
SITE_BASE_URL=http://localhost:8080

# 邮件（注册验证码需要）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=极验社区
